# EDEN - Visual AI Graph IDE
# Environment Configuration

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ============================================
# AI Configuration
# ============================================
# Google Gemini API Key (optional)
GEMINI_API_KEY=""

# Local Model Configuration
LOCAL_MODEL=qwen2.5-coder
LOCAL_API_URL=http://localhost:11434/api/generate
AI_TIMEOUT_MS=120000
MAX_AGENT_ITERATIONS=20

# ============================================
# Authentication
# ============================================
# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN="http://localhost:3000,http://localhost:4200"

# ============================================
# Database (Optional - for production)
# ============================================
# MongoDB Connection String
# MONGO_URI="mongodb://localhost:27017/eden"

# Redis Connection String
# REDIS_URL="redis://localhost:6379"

# ============================================
# Deployment Configuration
# ============================================
# Railway / Vercel
RAILWAY_ENV_GEMINI_API_KEY=""

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# SSL Configuration (for self-hosted)
# ============================================
# SSL_CERT_PATH="/etc/ssl/certs/eden.crt"
# SSL_KEY_PATH="/etc/ssl/private/eden.key"
