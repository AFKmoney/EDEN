# ============================================
# EDEN - Visual AI Graph IDE
# Environment Configuration
# ============================================

# Server Configuration
PORT=4000
NODE_ENV=development

# ============================================
# AI Providers Configuration
# ============================================

# Google Gemini API (Required for gemini tool)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Local Model Configuration (Ollama)
# Default: qwen2.5-coder (recommended for code generation)
# Other options: llama3.2, mistral, phi3, etc.
LOCAL_MODEL=qwen2.5-coder

# Local Ollama API URL
# Default: http://127.0.0.1:11434/api/generate
LOCAL_API_URL=http://127.0.0.1:11434/api/generate

# ============================================
# AI Timeout Configuration (in milliseconds)
# ============================================
AI_TIMEOUT_MS=120000  # 2 minutes

# ============================================
# Agent Configuration
# ============================================
MAX_AGENT_ITERATIONS=20
AGENT_MEMORY_ENABLED=true

# ============================================
# Security Configuration
# ============================================
# Rate limiting (requests per minute)
RATE_LIMIT=60

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info  # debug, info, warn, error

# ============================================
# Optional: Redis Configuration
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# Optional: Database Configuration (Future)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/eden

# ============================================
# Optional: Authentication Configuration (Future)
# ============================================
# JWT_SECRET=your-jwt-secret-key
# JWT_EXPIRES_IN=1d

# ============================================
# Angular SSR Configuration
# ============================================
# Set to 'true' to enable Server-Side Rendering
SSR_ENABLED=true
